# 中科安樵·护理院 SaaS 控制台 环境变量示例
# 复制本文件为 .env.local（前端）并填入；后端密钥由 systemd / shell 注入，勿提交真实值。

# ---- 后端（server/index.js，node 运行时 env）----
# 令牌 HMAC 签名密钥：生产必须强随机（openssl rand -hex 32）；未注入拒绝启动
TOKEN_SECRET=change-me
# 种子账号统一初始密码：未注入拒绝启动；上线后立即轮换（INTEGRATION-SPEC §6-4）
SEED_ACCOUNT_PASSWORD=change-me
# 监听端口，默认 8080（生产 2830/2831）
PORT=8080
# WS 冒烟：1 时新告警每 5-8s 生成一条（供测试），默认 45-75s
WS_ALERT_FAST=0

# ---- 前端（vite 构建时 env，VITE_ 前缀）----
# API 基路径：默认同源相对（开发走 vite proxy /v1 -> 8080；生产经 nginx 同域反代）
VITE_API_BASE=
# 部署基路径：默认 /saas/
VITE_BASE=/saas/
# 本地样例开关：仅 DEV 且 =1 时允许 mock 样例；默认走真实接口
VITE_USE_LOCAL_MOCK=