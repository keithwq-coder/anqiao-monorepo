# /etc/anqiao-console/env —— anqiao-console.service 环境变量（chmod 600）
# 对应 INTEGRATION-SPEC §6-3/#4：以下两项均无默认值，缺失服务拒绝启动。
# 本文件为模板，真实值由运维在目标机填写，禁止提交真实密钥。

# 令牌 HMAC 签名密钥（必填）：openssl rand -hex 32
TOKEN_SECRET=

# 种子账号统一初始密码（必填）：首次部署后立即轮换为强随机值
SEED_ACCOUNT_PASSWORD=

# 可选：阶段四数据层（seed=默认可回滚；sqlite=重启不丢）
# DATA_LAYER=sqlite
# DB_PATH=/opt/anqiao-console/server/anqiao.sqlite

# 可选：硬件云上游地址覆盖（默认文档 2.2：https://api.health-track.anqiaokj.com）
# 2.8 查询只转发 device_id（夜间另加 date），不要求 HW_ACCOUNT / HW_PASSWORD。
# HW_API_BASE=https://api.health-track.anqiaokj.com

# 可选：WS 冒烟加速（仅测试环境）
# WS_ALERT_FAST=0

# 可选：CORS 允许来源（逗号分隔；同源 nginx 反代场景可不设）
# ALLOWED_ORIGINS=https://anqiao.aibrain.wiki
