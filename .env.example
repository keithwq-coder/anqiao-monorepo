# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# --- Feishu Lark Credentials ---
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_BASE_ID=basexxxxxxxxxxxxxxx
FEISHU_TABLE_ID=tablerXXXXXXXXXXXXX
FEISHU_CORP_ID=your_corp_id_here

# --- Bot Webhook (Optional for notifications) ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook_your_webhook_key

# --- AI Provider (Third-party中转站) ---
AI_API_BASE=https://api.your-ai-provider.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=qwen-plus

# --- Scanning Configuration ---
SCAN_INTERVAL_HOURS=1
MAX_RETRIES=3
SCRAPE_TIMEOUT_SECONDS=30

# --- Customer Data ---
CUSTOMERS_CSV_PATH=customers.csv

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/crm_mvp.log
